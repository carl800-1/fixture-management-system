{
  "name": "fixture-mgmt",
  "version": "4.0.3",
  "description": "工装夹具管理程序 v4.0.3（Electron 桌面版，本地 JSON 文件存储；每套一条记录的追踪模型，夹具编号为主搜索键、序号系统自动分配；出库/回库/送修/报废流转，出库冻结库位、回库可改库位；库位管理与手工盘点；二维码标签生成与打印；机种字典与按机种分组查询；产线/工位关联与产线夹具查询（含产线示意图）；夹具查询多条件组合检索与派生数量合计；Excel/CSV 批量导入与导入撤销）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.spms.fixture",
    "productName": "工装夹具管理程序",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "index.html",
      "css/**",
      "js/**"
    ],
    "directories": {
      "output": "release_v21"
    },
    "win": {
      "target": ["dir"],
      "artifactName": "工装夹具管理程序_v4.0.3.${ext}"
    },
    "asar": false
  },
  "devDependencies": {
    "app-builder-bin": "^4.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.0.0",
    "pinyin-match": "^1.2.10"
  }
}

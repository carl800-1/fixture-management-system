{
  "name": "fixture-management-system",
  "version": "1.8.0",
  "description": "夹具管理系统 v1.8（Electron 桌面版，本地 JSON 文件存储，支持夹具出库/回库/维修重复流转，出库回库四栏互查、二维码前缀兼容、中文输入法守卫、库位管理、编号归一化匹配、二维码标签生成与打印）",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "Frank",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "node test_store.js && node test_render.js"
  },
  "build": {
    "appId": "com.spms.fixture",
    "productName": "夹具管理系统",
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "index.html",
      "css/**",
      "js/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["dir"],
      "artifactName": "夹具管理系统_v1.8.${ext}"
    },
    "asar": false
  },
  "devDependencies": {
    "app-builder-bin": "^4.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "pinyin-match": "^1.2.10"
  }
}
